{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run Weather App",
            "request": "launch",
            "mainClass": "weatherGui.Main",
            "vmArgs": [
                       "--module-path",
                    "C:/Program Files/Java/javafx-sdk-27/lib",
                    "--add-modules",
                    "javafx.controls,javafx.fxml,javafx.web",
                    "--add-exports",
                    "javafx.graphics/com.sun.javafx.sg.prism=ALL-UNNAMED"
            ]
        }
    ]
}